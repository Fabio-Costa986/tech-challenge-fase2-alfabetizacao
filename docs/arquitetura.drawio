><mxGeometry x="560" y="300" width="240" height="64" as="geometry"/></mxCell><mxCell id="c12" value="&lt;b&gt;Portão Silver&lt;/b&gt;&lt;br&gt;duplicidade, nulos, domínio, códigos,&lt;br&gt;taxa de match de cada join" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;spacing=8;fontSize=12;fontFamily=Helvetica;fontColor=#1A1A1A;fillColor=#FDECEA;strokeColor=#D93025;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="860" y="300" width="240" height="64" as="geometry"/></mxCell><mxCell id="c13" value="&lt;b&gt;Portão Gold&lt;/b&gt;&lt;br&gt;validação cruzada microdado × oficial,&lt;br&gt;vazamento de alvo, testes unitários" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;spacing=8;fontSize=12;fontFamily=Helvetica;fontColor=#1A1A1A;fillColor=#FDECEA;strokeColor=#D93025;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1160" y="300" width="240" height="64" as="geometry"/></mxCell><mxCell id="c14" value="&lt;font color=&quot;#52514E&quot; style=&quot;font-size:10px&quot;&gt;BigQuery público (US)&lt;/font&gt;&lt;br&gt;&lt;b&gt;basedosdados.br_inep_avaliacao_alfabetizacao&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;alunos, municipio, uf, 3 tabelas de meta,&lt;br&gt;dicionario + diretório de municípios&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;spacing=8;fontSize=12;fontFamily=Helvetica;fontColor=#1A1A1A;fillColor=#E8F0FE;strokeColor=#1A73E8;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="30" y="430" width="430" height="140" as="geometry"/></mxCell><mxCell id="c15" value="&lt;font color=&quot;#52514E&quot; style=&quot;font-size:10px&quot;&gt;Cloud Storage + tabelas externas&lt;/font&gt;&lt;br&gt;&lt;b&gt;BRONZE&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;gs://…-alfab-lake/bronze/&amp;lt;entidade&amp;gt;/&lt;br&gt;ingestion_date=/run_id=/ · Parquet ZSTD&lt;br&gt;overwrite=false · retenção 30 dias&lt;br&gt;a Silver lê só o run_id mais recente&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=