="c9" target="c10"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c27" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#52514E;strokeWidth=1.5;fontSize=10;endArrow=block;endFill=1;labelBackgroundColor=#FFFFFF;fontFamily=Helvetica;fontColor=#1A1A1A;" edge="1" parent="1" source="c10" target="c11"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c28" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#52514E;strokeWidth=1.5;fontSize=10;endArrow=block;endFill=1;labelBackgroundColor=#FFFFFF;fontFamily=Helvetica;fontColor=#1A1A1A;" edge="1" parent="1" source="c11" target="c12"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c29" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#52514E;strokeWidth=1.5;fontSize=10;endArrow=block;endFill=1;labelBackgroundColor=#FFFFFF;fontFamily=Helvetica;fontColor=#1A1A1A;" edge="1" parent="1" source="c12" target="c13"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c30" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#52514E;strokeWidth=1.5;fontSize=10;endArrow=block;endFill=1;labelBackgroundColor=#FFFFFF;fontFamily=Helvetica;fontColor=#1A1A1A;" edge="1" parent="1" source="c13" target="c14"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c31" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#52514E;strokeWidth=1.5;fontSize=10;endArrow=block;endFill=1;labelBackgroundColor=#FFFFFF;fontFamily=Helvetica;fontColor=#1A1A1A;" edge="1" parent="1" source="c13" target="c15"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c32" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#52514E;strokeWidth=1.5;fontSize=10;endArrow=block;endFill=1;labelBackgroundColor=#FFFFFF;fontFamily=Helvetica;fontColor=#1A1A1A;" edge="1" parent="1" source="c13" target="c16"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c33" value="métricas de cada etapa e resultados dos testes" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#7E57C2;strokeWidth=1.5;fontSize=10;endArrow=block;endFill=1;labelBackgroundColor=#FFFFFF;fontFamily=Helvetica;fontColor=#1A1A1A;dashed=1;exitX=0.5;exitY=1;entryX=0.522;entryY=0;" edge="1" parent="1" source="c11" target="c17"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c34" value="&lt;b&gt;Como ler&lt;/b&gt;&lt;br&gt;Dado ruim não avança: se uma regra bloqueante reprova, a camada seguinte não é construída e a Gold publicada continua a da última execução boa.&lt;br&gt;&lt;br&gt;Dado oficial e dado simulado nunca se misturam: toda linha carrega a origem." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;verticalAlign=top;spacing=10;fontSize=11;fillColor=#FFFDE7;strokeColor=#C9A227;fontFamily=Helvetica;fontColor=#1A1A1A;" vertex="1" parent="1"><mxGeometry x="30" y="600" width="240" height="170" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="pagina2" name="2. Fluxo batch"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1760" pageHeight="1040" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="Fluxo batch: orquestração, portões de qualidade e publicação" style="text;html=1;align=left;verticalAlign=middle;fontSize=20;fontStyle=1;fontFamily=Helvetica;fontColor=#1A1A1A;" vertex="1" parent="1"><mxGeometry x="30" y="20" width="1000" height="34" as="geometry"/></mxCell><mxCell id="c3" value="Projeto GCP · região us-central1 (computação) e US (dados) · infraestrutura em Terraform (82 recursos)" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontColor=#52514E;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="30" y="54" width="1100" height="22" as="geometry"/></mxCell><mxCell id="c4" value="&lt;font color=&quot;#52514E&quot; style=&quot;font-size:10px&quot;&gt;Cloud Scheduler&lt;/font&gt;&lt;br&gt;&lt;b&gt;alfab-batch&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;0 */6 * * * · &lt;b&gt;pausado&lt;/b&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;spacing=8;fontSize=12;fontFamily=Helvetica;fontColor=#1A1A1A;fillColor=#F1F6FE;strokeColor=#4285F4;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="30" y="135" width="180" height="90" as="geometry"/></mxCell><mxCell id="c5" value="&lt;font color=&quot;#52514E&quot; style=&quot;font-size:10px&quot;&gt;Cloud Workflows&lt;/font&gt;&lt;br&gt;&lt;b&gt;alfab-pipeline-batch&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;encadeia as etapas, injeta o run_id,&lt;br&gt;repete erros transitórios&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;spacing=8;fontSize=12;fontFamily=Helvetica;fontColor=#1A1A1A;fillColor=#F1F6FE;strokeColor=#4285F4;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="240" y="135" width="220" height="90" as="geometry"/></mxCell><mxCell id="c6" value="Cloud Run Jobs · imagem única (Artifact Registry: alfab/pipeline) · executados em sequência: cada um só roda se o anterior teve sucesso" style="rounded=1;whiteSpace=wrap;html=1;arcSize=3;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontSize=13;fontStyle=1;fillColor=#FAFAF8;strokeColor=#C3C2B7;fontFamily=Helvetica;fontColor=#1A1A1A;" vertex="1" parent="1"><mxGeometry x="540" y="100" width="1190" height="145" as="geometry"/></mxCell><mxCell id="c7" value="&lt;font color=&quot;#52514E&quot; style=&quot;font-size:10px&quot;&gt;Cloud Run Job&lt;/font&gt;&lt;br&gt;&lt;b&gt;alfab-ingest-bronze&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;watermark + dry run + EXPORT DATA&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;spacing=8;fontSize=12;fontFamily=Helvetica;fontColor=#1A1A1A;fillColor=#FFFFFF;strokeColor