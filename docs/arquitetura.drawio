 target="c26"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="175" y="932"/><mxPoint x="1265" y="932"/></Array></mxGeometry></mxCell><mxCell id="c52" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#7E57C2;strokeWidth=1.5;fontSize=10;endArrow=block;endFill=1;labelBackgroundColor=#FFFFFF;fontFamily=Helvetica;fontColor=#1A1A1A;dashed=1;" edge="1" parent="1" source="c26" target="c27"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell></root></mxGraphModel></diagram><diagram id="pagina3" name="3. Fluxo streaming"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1780" pageHeight="1000" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="Fluxo streaming: mensageria, quarentena, deduplicação e latência medida" style="text;html=1;align=left;verticalAlign=middle;fontSize=20;fontStyle=1;fontFamily=Helvetica;fontColor=#1A1A1A;" vertex="1" parent="1"><mxGeometry x="30" y="20" width="1100" height="34" as="geometry"/></mxCell><mxCell id="c3" value="Entrega at-least-once do Pub/Sub; unicidade garantida pelo MERGE do micro-lote; dado sempre marcado origem_dado = SIMULADO" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontColor=#52514E;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="30" y="54" width="1200" height="22" as="geometry"/></mxCell><mxCell id="c4" value="&lt;font color=&quot;#52514E&quot; style=&quot;font-size:10px&quot;&gt;Cloud Run Job&lt;/font&gt;&lt;br&gt;&lt;b&gt;alfab-simulator&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;gera eventos a partir de municípios reais&lt;br&gt;~5% duplicatas · ~3% inválidos&lt;br&gt;carimba &lt;b&gt;produced_at&lt;/b&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;spacing=8;fontSize=12;fontFamily=Helvetica;fontColor=#1A1A1A;fillColor=#FFFFFF;strokeColor=#9AA0A6;strokeWidth=1.5;dashed=1;" vertex="1" parent="1"><mxGeometry x="30" y="130" width="250" height="110" as="geometry"/></mxCell><mxCell id="c5" value="&lt;font color=&quot;#52514E&quot; style=&quot;font-size:10px&quot;&gt;Pub/Sub · tópico&lt;/font&gt;&lt;br&gt;&lt;b&gt;alfab-eventos&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;retenção de 7 dias&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;spacing=8;fontSize=12;fontFamily=Helvetica;fontColor=#1A1A1A;fillColor=#F1F6FE;strokeColor=#4285F4;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="340" y="140" width="200" height="90" as="geometry"/></mxCell><mxCell id="c6" value="&lt;font color=&quot;#52514E&quot; style=&quot;font-size:10px&quot;&gt;Pub/Sub · subscription push&lt;/font&gt;&lt;br&gt;&lt;b&gt;alfab-eventos-push&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;token OIDC · retry 10–600 s&lt;br&gt;até 5 tentativas&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;spacing=8;fontSize=12;fontFamily=Helvetica;fontColor=#1A1A1A;fillColor=#F1F6FE;strokeColor=#4285F4;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="590" y="140" width="230" height="90" as="geometry"/></mxCell><mxCell id="c7" value="&lt;font color=&quot;#52514E&quot; style=&quot;font-size:10px&quot;&gt;Cloud Run (serviço, escala a zero)&lt;/font&gt;&lt;br&gt;&lt;b&gt;alfab-event-ingestor&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;valida o contrato do evento&lt;br&gt;carimba &lt;b&gt;ingested_at&lt;/b&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;spacing=8;fontSize=12;fontFamily=Helvetica;fontColor=#1A1A1A;fillColor=#FFFFFF;strokeColor=#4285F4;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="890" y="130" width="260" height="110" as="geometry"/></mxCell><mxCell id="c8" value="&lt;font color=&quot;#52514E&quot; style=&quot;font-size:10px&quot;&gt;BigQuery&lt;/font&gt;&lt;br&gt;&lt;b&gt;bronze.eventos_raw&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;toda entrega é gravada,&lt;br&gt;inclusive reentregas (duplicatas)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;spacing=8;fontSize=12;fontFamily=Helvetica;fontColor=#1A1A1A;fillColor=#F6E6D6;strokeColor=#B87333;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1240" y="140" width="230" height="90" as="geometry"/></mxCell><mxCell id="c9" value="&lt;font color=&quot;#52514E&quot; style=&quot;font-size:10px&quot;&gt;Pub/Sub · fila de descarte&lt;/font&gt;&lt;br&gt;&lt;b&gt;alfab-eventos-dlq&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;+ alfab-eventos-dlq-inspect&lt;br&gt;mensagens que falharam 5 entregas&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;spacing=8;fontSize=12;fontFamily=Helvetica;fontColor=#1A1A1A;fillColor=#FDECEA;strokeColor=#D93025;strokeWidth=1.5;dashed=1;" vertex="1" parent="1"><mxGeometry x="590" y="310" width="230" height="100" as="geometry"/></mxCell><mxCell id="c10" value="&lt;font color=&quot;#52514E&quot; style=&quot;font-size:10px&quot;&gt;BigQuery&lt;/font&gt;&lt;br&gt;&lt;b&gt;bronze.eventos_quarentena&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;evento rejeitado + motivo&lt;br&gt;(estrutura, domínio ou referência)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;spacing=8;fontSize=12;fontFamily=Helvetica;fontColor=#1A1A1A;fillColor=#FDECEA;strokeColor=#D93025;strokeWidth=1.5;dashed=1;" vertex="1" parent="1"><mxGeometry x="1370" y="310" width="230" height="100" as="geometry"/></mxCell><mxCell id="c11" value="&lt;font color=&quot;#52514E&quot; style=&quot;font-size:10px&quot;&gt;Cloud Scheduler&lt;/font&gt;&lt;br&gt;&lt;b&gt;alfab-microbatch&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;*/5 * * * * · &lt;b&gt;pausado&lt;/b&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;spacing=8;fontSize=12;fontFamily=Helvetica;fontColor=#1A1A1A;fillColor=#F1F6FE;strokeColor=#4285F4;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="590" y="520" width="230" height="90" as="geometry"/></mxCell><mxCell id="c12" value="&lt;font color=&quot;#52514E&quot; style=&quot;font-size:10px&quot;&gt;Cloud Run Job&lt;/font&gt;&lt;br&gt;&lt;b&gt;alfab-microbatch&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;janela por watermark + 10 min de segurança&lt;br&gt;ROW_NUMBER por event_id (dentro do lote)&lt;br&gt;valida município contra o diretório&lt;br&gt;MERGE idempotente (entre lotes, 7 dias)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;spacing=8;fontSize=12;fontFamily=Helvetica;fontColor=#1A1A1A;fillColor=#FFFFFF;strokeColor=#4285F4;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="890" y="500" width="260" height="130" as="geometry"/></mxCell><mxCell id="c13" value="&lt;font color=&quot;#52514E&quot; style=&quot;font-size:10px&quot;&gt;BigQuery&lt;/font&gt;&lt;br&gt;&lt;b&gt;silver.eventos&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;1 linha por event_id&lt;br&gt;carimba &lt;b&gt;silver_processed_at&lt;/b&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;spacing=8;fontSize=12;fontFamily=Helvetica;fontColor=#1A1A1A;fillColor=#ECEFF1;strokeColor=#78909C;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1240" y="520" width="230" height="90" as="geometry"/></mxCell><mxCell id="c14" value="&lt;font color=&quot;#52514E&quot; style=&quot;font-size:10px&quot;&gt;BigQuery · views&lt;/font&gt;&lt;br&gt;&lt;b&gt;gold.vw_indicador_consolidado&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;OFICIAL (batch) + SIMULADO (streaming),&lt;br&gt;separados por origem_dado&lt;br&gt;+ gold.vw_eventos_tempo_real&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;spacing=8;fontSize=12;fontFamily=Helvetica;fontColor=#1A1A1A;fillColor=#FFF3C4;strokeColor=#C9A227;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1530" y="510" width="220" height="110" as="geometry"/></mxCell><mxCell id="c15" value="Observabilidade do streaming" style="rounded=1;whiteSpace=wrap;html=1;arcSize=3;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontSize=13;fontStyle=1;fillColor=#FAFAF8;strokeColor=#C3C2B7;fontFamily=Helvetica;fontColor=#1A1A1A;" vertex="1" parent="1"><mxGeometry x="30" y="720" width="1720" height="240" as="geometry"/></mxCell><mxCell id="c16" value="&lt;font color=&quot;#52514E&quot; style=&quot;font-size:10px&quot;&gt;BigQuery&lt;/font&gt;&lt;br&gt;&lt;b&gt;ops.pipeline_runs&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;por micro-lote: lidas, únicas, novas,&lt;br&gt;duplicatas descartadas, quarentena,&lt;br&gt;latência p50/p95/p99&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;spacing=8;fontSize=12;fontFamily=Helvetica;fontColor=#1A1A1A;fillColor=#EDE7F6;strokeColor=#7E57C2;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="50" y="770" width="270" height="110" as="geometry"/></mxCell><mxCell id="c17" value="&lt;font color=&quot;#52514E&quot; style=&quot;font-size:10px&quot;&gt;BigQuery&lt;/font&gt;&lt;br&gt;&lt;b&gt;ops.stream_watermark&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;até onde o micro-lote já processou&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;spacing=8;fontSize=12;fontFamily=Helvetica;fontColor=#1A1A1A;fillColor=#EDE7F6;strokeColor=#7E57C2;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="340" y="770" width="240" height="110" as="geometry"/></mxCell><mxCell id="c18" value="&lt;font color=&quot;#52514E&quot; style=&quot;font-size:10px&quot;&gt;BigQuery · view&lt;/font&gt;&lt;br&gt;&lt;b&gt;ops.vw_latencia_streaming&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;ingested_at − produced_at&lt;br&gt;(dois relógios diferentes)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;spacing=8;fontSize=12;fontFamily=Helvetica;fontColor=#1A1A1A;fillColor=#EDE7F6;strokeColor=#7E57C2;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="600" y="770" width="250" height="110" as="geometry"/></mxCell><mxCell id="c19" value="&lt;font color=&quot;#52514E&quot; style=&quot;font-size:10px&quot;&gt;Cloud Monitoring&lt;/font&gt;&lt;br&gt;&lt;b&gt;4 políticas de alerta → e-mail&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;backlog &amp;gt; 5 min · fila de descarte &amp;gt; 0&lt;br&gt;latência p95 &amp;gt; 60 s · quarentena &amp;gt; 10%&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;spacing=8;fontSize=12;fontFamily=Helvetica;fontColor=#1A1A1A;fillColor=#EDE7F6;strokeColor=#7E57C2;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="870" y="770" width="300" height="110" as="geometry"/></mxCell><mxCell id="c20" value="&lt;b&gt;Medido na nuvem (3 rodadas)&lt;/b&gt;&lt;br&gt;1.240 eventos publicados · 1.206 entregas na Bronze para 1.135 distintos&lt;br&gt;71 duplicatas: 39 do simulador e &lt;b&gt;32 reentregas reais do Pub/Sub&lt;/b&gt;&lt;br&gt;1.125 na Silver, sem duplicata · 50 na quarentena&lt;br&gt;latência de ingestão p50: 0,066 s (5,097 s com 5 s de atraso injetado)" style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;verticalAlign=top;spacing=10;fontSize=11;fillColor=#FFFDE7;strokeColor=#C9A227;fontFamily=Helvetica;fontColor=#1A1A1A;" vertex="1" parent="1"><mxGeometry x="1230" y="760" width="500" height="130" as="geometry"/></mxCell><mxCell id="c21" value="publica" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#52514E;strokeWidth=1.5;fontSize=10;endArrow=block;endFill=1;labelBackgroundColor=#FFFFFF;fontFamily=Helvetica;fontColor=#1A1A1A;" edge="1" parent="1" source="c4" target="c5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c22" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#52514E;strokeWidth=1.5;fontSize=10;endArrow=block;endFill=1;labelBackgroundColor=#FFFFFF;fontFamily=Helvetica;fontColor=#1A1A1A;" edge="1" parent="1" source="c5" target="c6"><mxGeometry relative="1" as="geometry"></mxGeome