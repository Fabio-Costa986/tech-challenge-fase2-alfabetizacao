<mxfile host="app.diagrams.net" type="device"><diagram id="pagina1" name="1. Visão geral"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1680" pageHeight="800" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="Pipeline híbrido do Indicador Criança Alfabetizada" style="text;html=1;align=left;verticalAlign=middle;fontSize=20;fontStyle=1;fontFamily=Helvetica;fontColor=#1A1A1A;" vertex="1" parent="1"><mxGeometry x="30" y="20" width="900" height="34" as="geometry"/></mxCell><mxCell id="c3" value="Google Cloud · arquitetura medalhão · batch + streaming · todos os componentes abaixo estão implementados e foram executados" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontColor=#52514E;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="30" y="54" width="1100" height="22" as="geometry"/></mxCell><mxCell id="c4" value="&lt;b&gt;Fonte oficial&lt;/b&gt;&lt;br&gt;Base dos Dados (Inep)&lt;br&gt;&lt;br&gt;alunos (3,9 milhões)&lt;br&gt;município · UF&lt;br&gt;metas Brasil, UF e município&lt;br&gt;dicionário de códigos" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;spacing=8;fontSize=12;fontFamily=Helvetica;fontColor=#1A1A1A;fillColor=#E8F0FE;strokeColor=#1A73E8;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="30" y="130" width="190" height="210" as="geometry"/></mxCell><mxCell id="c5" value="&lt;b&gt;Simulador de eventos&lt;/b&gt;&lt;br&gt;atualizações de indicador,&lt;br&gt;medições e metas&lt;br&gt;(dado marcado como SIMULADO)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;spacing=8;fontSize=12;fontFamily=Helvetica;fontColor=#1A1A1A;fillColor=#FFFFFF;strokeColor=#9AA0A6;strokeWidth=1.5;dashed=1;" vertex="1" parent="1"><mxGeometry x="30" y="400" width="190" height="110" as="geometry"/></mxCell><mxCell id="c6" value="&lt;b&gt;Ingestão batch&lt;/b&gt;&lt;br&gt;a cada 6 h&lt;br&gt;lê direto do BigQuery público&lt;br&gt;pula a fonte que não mudou" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;spacing=8;fontSize=12;fontFamily=Helvetica;fontColor=#1A1A1A;fillColor=#F1F6FE;strokeColor=#4285F4;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="300" y="180" width="190" height="110" as="geometry"/></mxCell><mxCell id="c7" value="&lt;b&gt;Ingestão streaming&lt;/b&gt;&lt;br&gt;mensageria Pub/Sub&lt;br&gt;eventos em segundos&lt;br&gt;inválidos vão para quarentena" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;spacing=8;fontSize=12;fontFamily=Helvetica;fontColor=#1A1A1A;fillColor=#F1F6FE;strokeColor=#4285F4;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="300" y="400" width="190" height="110" as="geometry"/></mxCell><mxCell id="c8" value="Arquitetura medalhão (BigQuery + Cloud Storage)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=3;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontSize=13;fontStyle=1;fillColor=#FAFAF8;strokeColor=#C3C2B7;fontFamily=Helvetica;fontColor=#1A1A1A;" vertex="1" parent="1"><mxGeometry x="540" y="110" width="930" height="430" as="geometry"/></mxCell><mxCell id="c9" value="&lt;b&gt;BRONZE&lt;/b&gt;&lt;br&gt;dado bruto&lt;br&gt;&lt;br&gt;cópia fiel da fonte&lt;br&gt;Parquet imutável&lt;br&gt;1 pasta por execução&lt;br&gt;histórico preservado" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;spacing=8;fontSize=12;fontFamily=Helvetica;fontColor=#1A1A1A;fillColor=#F6E6D6;strokeColor=#B87333;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="560" y="170" width="170" height="340" as="geometry"/></mxCell><mxCell id="c10" value="&lt;b&gt;Portão de qualidade&lt;/b&gt;&lt;br&gt;&lt;br&gt;só avança&lt;br&gt;se aprovado" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;spacing=8;fontSize=12;fontFamily=Helvetica;fontColor=#1A1A1A;fillColor=#FDECEA;strokeColor=#D93025;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="770" y="280" width="110" height="120" as="geometry"/></mxCell><mxCell id="c11" value="&lt;b&gt;SILVER&lt;/b&gt;&lt;br&gt;dado tratado&lt;br&gt;&lt;br&gt;tipos e chaves&lt;br&gt;padronizados&lt;br&gt;códigos traduzidos&lt;br&gt;pelo dicionário&lt;br&gt;6 entidades integradas" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;spacing=8;fontSize=12;fontFamily=Helvetica;fontColor=#1A1A1A;fillColor=#ECEFF1;strokeColor=#78909C;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="920" y="170" width="170" height="340" as="geometry"/></mxCell><mxCell id="c12" value="&lt;b&gt;Portão de qualidade&lt;/b&gt;&lt;br&gt;&lt;br&gt;só publica&lt;br&gt;se aprovado" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;spacing=8;fontSize=12;fontFamily=Helvetica;fontColor=#1A1A1A;fillColor=#FDECEA;strokeColor=#D93025;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1130" y="280" width="110" height="120" as="geometry"/></mxCell><mxCell id="c13" value="&lt;b&gt;GOLD&lt;/b&gt;&lt;br&gt;dado analítico&lt;br&gt;&lt;br&gt;resultado ×&lt;br&gt;meta pactuada&lt;br&gt;evolução temporal&lt;br&gt;validação cruzada&lt;br&gt;base para IA" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;spacing=8;fontSize=12;fontFamily=Helvetica;fontColor=#1A1A1A;fillColor=#FFF3C4;strokeColor=#C9A227;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1280" y="170" width="170" height="340" as="geometry"/></mxCell><mxCell id="c14" value="&lt;b&gt;Painel de resultados&lt;/b&gt;&lt;br&gt;Brasil, UFs e municípios&lt;br&gt;contra a meta" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;spacing=8;fontSize=12;fontFamily=Helvetica;fontColor=#1A1A1A;fillColor=#E6F4EA;strokeColor=#34A853;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1520" y="140" width="130" height="100" as="geometry"/></mxCell><mxCell id="c15" value="&lt;b&gt;Base para IA&lt;/b&gt;&lt;br&gt;(Fase 3)&lt;br&gt;sem vazamento de alvo" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;spacing=8;fontSize=12;fontFamily=Helvetica;fontColor=#1A1A1A;fillColor=#E6F4EA;strokeColor=#34A853;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1520" y="290" width