# Copie para .env e preencha. O .env NÃO é versionado.
# Estes são os ÚNICOS lugares onde identificadores de projeto/bucket aparecem;
# o código lê tudo via src/alfab/config.py e o Terraform via infra/terraform.tfvars.

GCP_PROJECT_ID=seu-projeto-gcp
# Multi-região US: obrigatória, pois o dataset público da Base dos Dados está em US
BQ_LOCATION=US
GCP_REGION=us-central1
BRONZE_BUCKET=seu-projeto-gcp-alfab-lake
PUBSUB_TOPIC=alfab-eventos
ALERT_EMAIL=grupo@exemplo.com

# Limite de segurança de bytes faturados por query (FinOps), em bytes. 50 GiB.
MAX_BYTES_BILLED=53687091200

# Autenticação: use ADC (gcloud auth application-default login). Nunca versionar chave JSON.
